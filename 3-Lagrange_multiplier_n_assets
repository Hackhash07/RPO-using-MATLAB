// lagrange method with single constaint
#include <iostream>
#include <vector>
using namespace std;

int main()
{
    int n;
    cin >> n;
    float A[n + 1][n + 1];
    float x[n + 1];
    float B[n + 1];
    float cov[n][n];
    float mean[n];
    float gamma;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if (i == j)
            {
                cout << "Enter the variance of asset " << i + 1 << ": ";
                cin >> cov[i][i];
            }
            else
            {
                if (i < j)
                {
                    cout << "Enter the covariance between asset " << i + 1 << " and asset " << j + 1 << ": ";
                    cin >> cov[i][j];
                    cov[j][i] = cov[i][j];
                }
            }
        }
    }
    for (int i = 0; i < n; i++)
    {
        cout << "Enter the mean of asset " << i + 1 << ": ";
        cin >> mean[i];
    }
    for (int i = 0; i <= n; i++)
    {
        for (int j = 0; j <= n; j++)
        {
            if (i < n && j < n)
            {
                A[i][j] = cov[i][j];
            }
            else if (i == n && j < n)
            {
                A[i][j] = 1;
            }
            else if (i < n && j == n)
            {
                A[i][j] = 1;
            }
            else
            {
                A[i][j] = 0;
            }
        }
    }
    for (int i = 0; i <= n; i++)
    {
        if (i < n)
        {
            B[i] = mean[i];
        }
        else
        {
            B[i] = 1;
        }
    }
    float pivot;
    for (int i = 0; i < n + 1; i++)
    {
        pivot = A[i][i];
        if (pivot != 1)
        {
            for (int j = 0; j < n + 1; j++)
            {
                A[i][j] = A[i][j] / pivot;
            }
            B[i] = B[i] / pivot;
        }
        for (int j = i + 1; j < n + 1; j++)
        {
            float factor = A[j][i] / A[i][i];
            for (int k = 0; k < n + 1; k++)
            {
                A[j][k] = A[j][k] - factor * A[i][k];
            }
            B[j] = B[j] - factor * B[i];
        }
    }
    for (int i = 0; i < n + 1; i++)
    {
        for (int j = 0; j < n + 1; j++)
        {
            cout << A[i][j] << " ";
            if (j == n)
            {
                cout << " | " << B[i];
            }
        }
        cout << endl;
    }
    for (int i = n; i >= 0; i--)
    {
        x[i] = B[i];

        for (int j = i + 1; j < n + 1; j++)
        {
            x[i] -= A[i][j] * x[j];
        }

        x[i] /= A[i][i];
    }
    for (int i = 0; i < n + 1; i++)
    {
        if (i < n)
        {
            cout << "The weight of asset " << i + 1 << " is: " << x[i] << endl;
        }
        else
        {
            cout << "The value of gamma is: " << x[i] << endl;
        }
    }

    return 0;
}